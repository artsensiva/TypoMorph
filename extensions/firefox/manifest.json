{
  "manifest_version": 3,
  "name": "TypoMorph",
  "version": "0.1.0",
  "description": "TypoMorph desktop connection status. Correction requires a supported desktop integration.",
  "browser_specific_settings": {
    "gecko": {
      "id": "typomorph@example.com",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "nativeMessaging"
  ]
}
